# Keep the build context small. The context is the repository root because
# component images need libs/ (see docs/08 section 1).
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/target
**/dist
docs
.env

# The exported training dataset: 226 MB of parquet that no image copies. It sits
# in the repository root, which IS the build context for the Python components
# (they need libs/), so without this line every one of those builds ships a
# quarter of a gigabyte to the daemon and discards it.
data

# Generated reports, including PNG figures. Read by humans, never by an image.
ml-training/reports
