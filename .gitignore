# Secrets and local configuration -- .env.example is versioned, .env never is.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Java / Maven
target/
*.class

# Node / Angular
node_modules/
dist/
.angular/

# Spark local artifacts
spark-warehouse/
checkpoints/
derby.log
metastore_db/

# Model artifacts are produced, never committed. Only their metadata is.
models/**/*.joblib

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Training artefacts: a model binary is a build output, so it is ignored by
# default and only the metadata describing the run is kept.
ml-training/artifacts/**/*.joblib

# One exception, deliberate (D-48, ADR-009). The artefact the streaming job
# loads at startup is the ONE file the platform cannot start without, and it is
# not rebuildable on a fresh clone: retraining needs a two-day dataset that is
# itself not committed. Keeping it out would mean "clone, then train for
# several minutes, then launch" -- and would silently break the one-command
# demonstration. 217 kB, whose SHA-256 is recorded in the metadata beside it and
# re-verified at every startup.
!ml-training/artifacts/one_class_svm/2.0.0/model.joblib
data/
