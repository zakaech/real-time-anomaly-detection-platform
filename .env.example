# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
#   make env        # creates .env from this file if it does not exist
#
# Every value below is read at runtime. No broker address, port or credential is
# hard-coded anywhere in the codebase: a missing required variable must make the
# component fail at startup rather than fall back to a silent default.
#
# Each variable is annotated:
#
#   [consumer] required|optional -- what it does
#
# "required" means `docker compose config` FAILS when it is unset, so a typo
# here is caught before anything starts rather than at the first request.
# "optional" means compose carries a fallback and the variable only overrides it.
#
# Every variable in this file is consumed by infra/docker-compose.yml, and that
# is enforced rather than trusted: `make check-env` (and the infra CI job) fails
# on a variable declared here and used nowhere, or used by compose and missing
# here. Two dead variables were removed in Phase 6 this way -- one of them,
# POSTGRES_PORT, was actively misleading, since the JDBC URL had the port
# written into it and changing the variable did nothing at all.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# [compose] optional -- prefixes containers, networks and volumes.
COMPOSE_PROJECT_NAME=anomaly-platform

# Pinned image tags. Never use `latest`: a rebuild months later would silently
# pull a different broker version and change behaviour.
#
# Honest limit: a tag is still mutable. `postgres:16.4-alpine` can be rebuilt
# upstream, so these pin a VERSION, not a set of bytes. Only a `sha256:` digest
# would do that, and this project keeps tags -- documented in the README under
# reproducibility rather than left to be discovered.

# [compose] required -- Kafka broker image (KRaft mode, no ZooKeeper).
KAFKA_IMAGE=apache/kafka:3.9.0
# [compose] required -- PostgreSQL image. The schema is owned by Flyway.
POSTGRES_IMAGE=postgres:16.4-alpine
# [compose] required -- Kafka console, only under `--profile tools`.
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

# [kafka] required -- KRaft cluster id: a base64url-encoded 16-byte value (22
# characters). Fixed here so the broker keeps its identity across down/up.
# Regenerate with:
#   python -c "import base64,uuid;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=8Z7WogCYQXqE3V4kOs2Gvw

# Two listeners on purpose. A single listener works either for containers or for
# host tools, never both: advertised.listeners returns one address, valid on one
# side of the Docker network only.

# [kafka, event-simulator, stream-processor, alert-service, kafka-ui] required
# -- the address every container uses to reach the broker.
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092

# [kafka] required -- host port mapped to the broker's EXTERNAL listener, for
# tools running outside Docker (kcat, an IDE, a script). Inside the container
# the listener is always 29092; this is only the host side of the mapping.
KAFKA_EXTERNAL_PORT=29092

# [kafka] required -- broker heap. Kept small so the whole stack fits on a
# developer machine.
KAFKA_HEAP_OPTS=-Xmx768m -Xms768m

# ---------------------------------------------------------------------------
# Kafka topics
#
# Names are configuration, not constants: an environment may prefix them.
# Partition counts are NOT configurable here -- they live in
# infra/kafka/create-topics.sh, because Kafka can never reduce a partition count
# and changing one silently would break per-key ordering for good.
# ---------------------------------------------------------------------------

# [event-simulator, stream-processor] required -- raw telemetry, 6 partitions.
KAFKA_TOPIC_TELEMETRY_RAW=telemetry.raw
# [stream-processor, alert-service] required -- scored windows, 6 partitions.
# Consumed by alert-service to persist the dashboard curves (D-41).
KAFKA_TOPIC_TELEMETRY_SCORED=telemetry.scored
# [stream-processor, alert-service] required -- alerts, 3 partitions.
KAFKA_TOPIC_ALERTS=alerts
# [event-simulator] required -- ground truth, 3 partitions. Never joined to the
# telemetry topic at runtime; it exists for training and evaluation only.
KAFKA_TOPIC_TELEMETRY_LABELS=telemetry.labels
# [stream-processor, alert-service] required -- dead letters, 1 partition: it is
# read end to end by a human, never parallelised.
KAFKA_TOPIC_TELEMETRY_DLQ=telemetry.dlq
# [stream-processor] required -- events that arrived after the watermark,
# 1 partition. Observability, not a queue to reprocess.
KAFKA_TOPIC_TELEMETRY_LATE=telemetry.late

# ---------------------------------------------------------------------------
# PostgreSQL
#
# Development credentials only. A real deployment injects these from a secret
# manager; a value committed to git must be considered compromised for ever,
# since history is immutable.
# ---------------------------------------------------------------------------

# [postgres, alert-service] required -- database name.
POSTGRES_DB=anomaly
# [postgres, alert-service] required -- role used by alert-service.
POSTGRES_USER=anomaly
# [postgres, alert-service] required -- placeholder, not a real secret. Change
# it locally; never commit the value you use.
POSTGRES_PASSWORD=change-me-locally
# [alert-service] required -- hostname inside the compose network, used to build
# the JDBC URL.
POSTGRES_HOST=postgres
# [postgres] required -- host port mapped to 5432, for psql or a GUI client from
# the host. Containers never use it; they reach the database on 5432 directly.
POSTGRES_EXTERNAL_PORT=5432

# ---------------------------------------------------------------------------
# Tooling profile (docker compose --profile tools up)
# ---------------------------------------------------------------------------

# [kafka-ui] required -- host port of the Kafka console.
KAFKA_UI_PORT=8085

# ---------------------------------------------------------------------------
# Event simulator (profile: sim)
# ---------------------------------------------------------------------------

# [event-simulator] optional -- realtime: event time tracks the wall clock, one
# tick per interval. replay: event time starts in the past and runs as fast as
# configured, to build a historical dataset quickly. Replay requires a bound.
SIMULATOR_MODE=realtime
# [event-simulator] optional -- seconds between two ticks in realtime mode.
SIMULATOR_TICK_INTERVAL_SECONDS=1.0

# [event-simulator] optional -- left empty on purpose: an unset seed is drawn and
# logged, so any run stays reproducible afterwards. Set one to make a run
# repeatable in advance.
SIMULATOR_SEED=

# [event-simulator] optional -- bounds. Replay refuses to start without one of
# the two, since an unbounded replay would generate event times in the future.
SIMULATOR_DURATION_SECONDS=
SIMULATOR_MAX_EVENTS=

# [event-simulator] optional -- simulated seconds per real second. Empty means
# unbounded in replay mode.
SIMULATOR_SPEED_FACTOR=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# [all] optional -- root log level for every component. Logs are structured JSON.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Stream processor (profile: stream)
# ---------------------------------------------------------------------------

# [stream-processor] optional -- Spark master. local[2] runs driver and
# executors in one container, which is what a laptop can carry.
STREAM_MASTER=local[2]

# [stream-processor] optional -- where the model artefact is mounted, INSIDE the
# container. The host side is the read-only bind mount declared in compose:
# ../ml-training/artifacts -> /models. The job verifies the SHA-256, the
# scikit-learn version, the feature-set version and the column order of whatever
# it finds there, and refuses to start on a mismatch (ADR-001).
STREAM_ARTIFACT_DIR=/models/one_class_svm/2.0.0

# [stream-processor] optional -- windowing must match what the model was trained
# on; the job asserts the feature-set version against the artefact at startup.
STREAM_WINDOW_SECONDS=60
STREAM_SLIDE_SECONDS=10

# [stream-processor] optional -- 90 s, not the 30 s of the Phase 0 design
# (ADR-003). The simulator buffers a machine for 20-75 s during an outage and
# adds up to 9 s of jitter, so the configured worst case is about 84 s. Specific
# to the simulated environment: a real plant needs this recalibrated from
# measurement.
STREAM_WATERMARK_SECONDS=90

# [stream-processor] optional -- micro-batch interval.
STREAM_TRIGGER_SECONDS=10
# [stream-processor] optional -- rate limiting, which is what backpressure is in
# Structured Streaming.
STREAM_MAX_OFFSETS_PER_TRIGGER=20000
# [stream-processor] optional -- earliest replays the retention window on a cold
# start, which is safe because persistence is idempotent.
STREAM_STARTING_OFFSETS=earliest
# [stream-processor] optional -- off for a backfill: producer lag is meaningless
# when replaying history.
STREAM_LATE_DETECTION_ENABLED=true
# [stream-processor] optional -- blank means unbounded. Settings treat an empty
# variable as unset, because compose expands an undefined one to an empty
# string. Set it to a number of seconds for a bounded demonstration run; that is
# exactly what `make demo` does.
STREAM_RUN_SECONDS=

# ---------------------------------------------------------------------------
# Alert service (Spring Boot). Starts with the stack: it is a passive consumer,
# not a data producer, so it needs no profile.
# ---------------------------------------------------------------------------

# [alert-service] optional -- host port. The API and the OpenAPI console
# (/swagger-ui.html) are reachable here.
ALERT_SERVICE_EXTERNAL_PORT=8081
# [alert-service] optional -- consumer group for the alerts topic.
ALERT_SERVICE_CONSUMER_GROUP=alert-service
# [alert-service] optional -- the alerts topic has 3 partitions; extra consumer
# threads would sit idle.
ALERT_SERVICE_CONCURRENCY=3

# [alert-service] optional -- telemetry persisted for the dashboard curves
# (decision D-41). Its own consumer group: telemetry.scored carries far more
# traffic than `alerts`, and the operator queue must never queue behind chart
# data.
ALERT_SERVICE_TELEMETRY_GROUP=alert-service-telemetry
# [alert-service] optional -- telemetry.scored has 6 partitions; more threads
# than partitions idle.
ALERT_SERVICE_TELEMETRY_CONCURRENCY=2
# [alert-service] optional -- measured growth is roughly 5700 rows/hour; the
# chart only shows recent history, so older rows are dead weight.
TELEMETRY_RETENTION_HOURS=72

# ---------------------------------------------------------------------------
# Angular dashboard. nginx serves the SPA and proxies /api to alert-service, so
# the browser sees one origin and no CORS configuration is needed (D-42).
# ---------------------------------------------------------------------------

# [dashboard] optional -- host port. This is the URL to open: http://localhost:4200
DASHBOARD_EXTERNAL_PORT=4200
# [dashboard] optional -- relative on purpose: the API is reached through the
# same origin as the dashboard. Written into assets/config.json at container
# start, so one image runs anywhere without a rebuild.
DASHBOARD_API_BASE_URL=/api/v1
# [dashboard] optional -- how many alerts the live feed keeps on screen.
DASHBOARD_LIVE_FEED_LIMIT=100
# [dashboard] optional -- SSE reconnection backoff. Native EventSource retry is
# disabled in favour of this, because the browser retries on a fixed interval
# and would hammer a backend that is down.
DASHBOARD_SSE_INITIAL_BACKOFF_MS=1000
DASHBOARD_SSE_MAX_BACKOFF_MS=30000
